{
  "name": "savepoint",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Save Point: a shared game log. The site itself has no build step; these are only the test and lint tools.",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node tests/run.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10"
  }
}
